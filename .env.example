# Database (Supabase Postgres). DATABASE_URL = pooled (transaction mode), DIRECT_URL = direct (migrations)
DATABASE_URL=
DIRECT_URL=

# Supabase (Storage) – service role is server-only
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Cron protection (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Cloudflare R2 backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Israel CBS (Central Bureau of Statistics) API
CBS_API_BASE_URL=https://api.cbs.gov.il

# Public base URL of the app
APP_BASE_URL=http://localhost:3000

# Optional
SENTRY_DSN=
